{
  "info": {
    "_postman_id": "a7f3c891-4b2e-4f8a-9c12-7e8a90b34d02",
    "name": "Glitch Room - Flow 2 (Challenges, AI Grading, Points & Badges)",
    "description": "Industry-standard Postman Collection v2.1 for testing Glitch Room Flow 2 APIs.\n\nHOW TO USE:\n1. Set `SUPABASE_URL` and `ANON_KEY` in Collection Variables (from your .env).\n2. Set `TEST_EMAIL` and `TEST_PASSWORD` in request `00. Login & Auto-Capture JWT`.\n3. Run `00. Login` first — its Test script automatically saves `USER_JWT` and `USER_ID` for all other requests.\n4. Note: Direct POST/PATCH calls to `glitch_activity`, `user_points`, or `profiles` also act as RLS Penetration Tests — under strict production RLS, tampering with points from Postman should be rejected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "SUPABASE_URL",
      "value": "https://your-project-ref.supabase.co",
      "type": "string"
    },
    {
      "key": "ANON_KEY",
      "value": "your-supabase-anon-or-publishable-key",
      "type": "string"
    },
    {
      "key": "USER_JWT",
      "value": "",
      "type": "string"
    },
    {
      "key": "USER_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "CHALLENGE_ID",
      "value": "1",
      "type": "string"
    },
    {
      "key": "CHALLENGE_TYPE",
      "value": "glitch",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Auth Setup (Run First)",
      "item": [
        {
          "name": "00. Login & Auto-Capture JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"USER_JWT\", jsonData.access_token);",
                  "    console.log(\"USER_JWT updated successfully\");",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set(\"USER_ID\", jsonData.user.id);",
                  "    console.log(\"USER_ID set to:\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{ANON_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-test-user@example.com\",\n  \"password\": \"YourPassword123!\"\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          }
        }
      ]
    },
